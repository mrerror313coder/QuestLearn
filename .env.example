# QuestLearn: Shadows of the Machine - Environment Configuration

# Application Port
PORT=8000

# Open-Weight Google Gemma Configuration (via Groq, HuggingFace, or local Ollama)
# For Groq: https://api.groq.com/openai/v1 (model: gemma2-9b-it)
# For local Ollama: http://localhost:11434/v1 (model: gemma:2b or gemma2)
GEMMA_API_BASE=https://api.groq.com/openai/v1
GEMMA_API_KEY=
GEMMA_MODEL=gemma2-9b-it

# MongoDB Atlas Connection URI (optional, falls back to local SQLite if empty)
MONGO_URI=
